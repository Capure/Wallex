{
  "name": "wallex",
  "description": "An open-source Wallpaper engine alternative.",
  "version": "1.1.0",
  "license": "GPL-3.0-only",
  "author": "Capure",
  "main": "lib/index.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "build": "npm run build:native && npm run build:types && npm run build:js",
    "build:native": "node-gyp configure && npm run build:rebuild-native",
    "build:rebuild-native": "set HOME=~/.electron-gyp && node-gyp rebuild --target=38.4.0 --arch=x64 --dist-url=https://electronjs.org/headers",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "babel src --out-dir lib --extensions \".ts,.tsx\" --source-maps inline",
    "start": "electron lib/index.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.3",
    "@babel/core": "^7.8.3",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.13.9",
    "@babel/preset-env": "^7.8.3",
    "@babel/preset-typescript": "^7.8.3",
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^22.14.0",
    "electron": "^38.4.0",
    "node-gyp": "^11.1.0",
    "typescript": "^4.2.3"
  },
  "dependencies": {
    "@babel/runtime": "^7.13.9",
    "bindings": "^1.5.0"
  }
}
